{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/experience/**",
              "components/forms/**",
              "components/layout/**",
              "components/surfaces/**",
              "components/typography/**",
              "components/ui/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|external|tone|style|children|key|ref|className|style|children)$/]",
        "message": "<AnimatedLink> doesn't accept that prop. Declared props: href, external, tone, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|body|strong)$/]",
        "message": "<AnimatedLink> tone must be one of 'accent' | 'body' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|iconLeft|iconRight|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, iconLeft, iconRight, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|external|variant|index|label|title|meta|media|interactive|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: href, external, variant, index, label, title, meta, media, interactive, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glass|solid|outline)$/]",
        "message": "<Card> variant must be one of 'glass' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|as|style|children|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: width, as, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:wide|text|full)$/]",
        "message": "<Container> width must be one of 'wide' | 'text' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|hint|error|required|style|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, htmlFor, hint, error, required, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|tone|style|children|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, size, tone, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:strong|dim|accent)$/]",
        "message": "<Heading> tone must be one of 'strong' | 'dim' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: invalid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|variant|size|external|iconLeft|iconRight|style|children|key|ref|className|style|children)$/]",
        "message": "<LinkButton> doesn't accept that prop. Declared props: href, variant, size, external, iconLeft, iconRight, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<LinkButton> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<LinkButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MagneticButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:strength|radius|style|children|key|ref|className|style|children)$/]",
        "message": "<MagneticButton> doesn't accept that prop. Declared props: strength, radius, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SceneBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:fixed|interactive|style|key|ref|className|style|children)$/]",
        "message": "<SceneBackdrop> doesn't accept that prop. Declared props: fixed, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|index|tight|bleed|hairline|width|style|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: id, label, index, tight, bleed, hairline, width, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:wide|text|full)$/]",
        "message": "<Section> width must be one of 'wide' | 'text' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|style|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: accent, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:invalid|rows|style|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: invalid, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextReveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|as|delay|stagger|once|style|children|key|ref|className|style|children)$/]",
        "message": "<TextReveal> doesn't accept that prop. Declared props: text, as, delay, stagger, once, style, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
